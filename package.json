{
  "name": "@zixcel/document-structure",
  "version": "0.12.2",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Bounded format-neutral structured surface document structure contract",
  "files": [
    "dist",
    "README.md",
    "repository.toml",
    "LICENSE",
    "NOTICE",
    "README.ja.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "test": "npm run build && node --test test/*.test.mts",
    "typecheck": "tsc -p tsconfig.json",
    "test:consumer": "node scripts/verify-packed-consumer.mts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "check:tooling": "tsc -p tsconfig.tooling.json && node --test scripts/source-languages.test.mts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zixcel/document-processing.git"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "22.19.7"
  },
  "keywords": [
    "document-processing",
    "parsing",
    "markdown",
    "html",
    "rust",
    "typescript"
  ]
}
