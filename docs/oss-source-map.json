{
  "repository": "zixcel/document-processing",
  "purpose": "Bounded format-neutral document structure and HTML/CommonMark adapters.",
  "responsibility_boundary": "Language meaning, product roles and execution authorization are outside document parsing/rendering.",
  "packages": [
    {
      "manifest": "crates/document-output/Cargo.toml",
      "package": "zixcel-document-output",
      "ecosystem": "rust",
      "description": "Bounded local document output boundary for Zixcel",
      "interfaces": {
        "lib": "crates/document-output/src/lib.rs",
        "features": {},
        "bins": [],
        "public_modules": [],
        "public_reexports": [
          "pdf::{\n    PdfAnalysisReport, PdfAnalysisRequest, PdfPageAnalysis, PdfReadCapability, PdfSummary,\n    PdfWriteCapability, analyze_pdf, write_pdf_report,\n}",
          "boundary::ConnectorError",
          "config::{ConnectorConfig, MaximumClassification, Renderer, parse_config}",
          "plan::{ConnectorPlan, PlanStep, build_plan}",
          "render::{RenderReceipt, render}",
          "reports::{\n    CapabilityReport, DoctorReport, ValidationReport, capabilities, doctor, validation_report,\n}"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    },
    {
      "manifest": "crates/json-structure/Cargo.toml",
      "package": "zixcel-json-structure",
      "ecosystem": "rust",
      "description": "Bounded source-linked JSON structure without language meaning or authority",
      "interfaces": {
        "lib": "crates/json-structure/src/lib.rs",
        "features": {},
        "bins": [],
        "public_modules": [],
        "public_reexports": [
          "bytes::check_bytes",
          "model::{Decomposition, SourceNode, SourceShape, SourceTree, StructureBudget}"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    },
    {
      "manifest": "package.json",
      "package": "@zixcel/document-structure",
      "ecosystem": "npm",
      "description": "Bounded format-neutral structured surface document structure contract",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./src/index.d.mts",
            "import": "./src/index.mjs"
          }
        },
        "bin": {},
        "main": null,
        "types": null
      },
      "declared_commands": {
        "test": "node --test test/*.test.mjs",
        "typecheck": "tsc -p tsconfig.json",
        "test:consumer": "node scripts/verify-packed-consumer.mjs"
      }
    },
    {
      "manifest": "packages/document-html/package.json",
      "package": "@zixcel/document-html",
      "ecosystem": "npm",
      "description": "Bounded WHATWG HTML structured-surface adapter",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./src/index.d.mts",
            "import": "./src/index.mjs"
          }
        },
        "bin": {},
        "main": null,
        "types": null
      },
      "declared_commands": {
        "test": "node --test test/*.test.mjs"
      }
    },
    {
      "manifest": "packages/document-markdown/package.json",
      "package": "@zixcel/document-markdown",
      "ecosystem": "npm",
      "description": "Bounded CommonMark structured-surface adapter",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./src/index.d.mts",
            "import": "./src/index.mjs"
          }
        },
        "bin": {},
        "main": null,
        "types": null
      },
      "declared_commands": {
        "test": "node --test test/*.test.mjs"
      }
    }
  ],
