              "run": "pnpm install --frozen-lockfile --ignore-scripts\npnpm -r --include-workspace-root run build\npnpm run typecheck\npnpm -r --include-workspace-root test\npnpm audit --audit-level=low\npnpm run check:tooling\nnode scripts/verify-packed-consumer.mts\n",
              "uses": null,
              "condition": null
            },
            {
              "name": "Pack exact source distributions without lifecycle hooks",
              "run": "mkdir outgoing\nnpm pack --ignore-scripts --json --pack-destination \"$GITHUB_WORKSPACE/outgoing\"\n(cd packages/document-html && npm pack --ignore-scripts --json --pack-destination \"$GITHUB_WORKSPACE/outgoing\")\n(cd packages/document-markdown && npm pack --ignore-scripts --json --pack-destination \"$GITHUB_WORKSPACE/outgoing\")\nprintf '%s\\n' \"$GITHUB_SHA\" > outgoing/source-sha.txt\n(cd outgoing && sha256sum ./*.tgz > SHA256SUMS)\n",
              "uses": null,
              "condition": null
            },
