{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "paths": {
      "@zixcel/document-html": [
        "./packages/document-html/dist/index.d.mts"
      ],
      "@zixcel/document-markdown": [
        "./packages/document-markdown/dist/index.d.mts"
      ]
    }
  },
  "include": [
    "scripts/*.mts",
    "test/*.mts",
    "packages/*/test/*.mts",
    "playground/**/*.mts"
  ]
}
